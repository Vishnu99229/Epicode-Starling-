# Starling env — copy to .env and fill FILL_IN values.
# Switch between profiles by commenting/uncommenting the block you use.
# Never commit .env. Tokens/keys stay here or in secrets/, not in docs.

# =============================================================================
# COMMON (always set)
# =============================================================================
DATABASE_URL=postgres://starling:starling@localhost:5432/starling?sslmode=disable
REDIS_URL=redis://localhost:6379/0
SMOKE_LIVE=false
# SIP extension or phone number dialed by the live smoke test
TEST_TO_NUMBER=FILL_IN
# Local ledger webhook receiver port (smoke test / Phase 1 ledger)
WEBHOOK_PORT=8080

# =============================================================================
# --- PROFILE: CLOUD_VM (primary) ---
# Your own IraVoice + BotCompose on the cloud VM (tenant vishnu / site vishnu_test).
# Uncomment and fill when DEBs are installed and endpoints are reachable.
# =============================================================================
# BOTCOMPOSE_BASE_URL=FILL_IN
# IRAVOICE_MAKECALL_URL=FILL_IN
# EPICODE_TENANT=vishnu
# EPICODE_SITE=vishnu_test
# BOTCOMPOSE_BEARER_TOKEN=FILL_IN
# IRAVOICE_BEARER_TOKEN=FILL_IN
# # Provider secrets for optional smoke add_secret (fresh tenant may need these)
# DEEPGRAM_API_KEY=FILL_IN
# GROQ_API_KEY=FILL_IN
# SARVAM_API_KEY=FILL_IN
# # Public URL IraVoice POSTs events + CDR to (VM private IP or ngrok tunnel → WEBHOOK_PORT)
# EVENT_URL=FILL_IN

# =============================================================================
# --- PROFILE: REMOTE_SANDBOX (fallback) ---
# Shared Epicode sandbox (tenant copter). Use for dry add_bot/get_bot before your cluster exists.
# =============================================================================
BOTCOMPOSE_BASE_URL=https://sandboxwa.epicode.in/api
IRAVOICE_MAKECALL_URL=https://sandboxld.epicode.in/api/makecall
EPICODE_TENANT=copter
EPICODE_SITE=FILL_IN
EPICODE_CAMPAIGN=csdemo2
BOTCOMPOSE_BEARER_TOKEN=FILL_IN
IRAVOICE_BEARER_TOKEN=FILL_IN
# Optional on sandbox (secrets often already present); still FILL_IN if you run ADD_SECRETS=true
DEEPGRAM_API_KEY=FILL_IN
GROQ_API_KEY=FILL_IN
SARVAM_API_KEY=FILL_IN
# Must resolve to the local webhook when SMOKE_LIVE=true (tunnel or same-network URL)
EVENT_URL=FILL_IN

# Smoke helpers (optional)
# ADD_SECRETS=false
